# --- Infra (docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Base URI; each service appends its own database name (auth, problems).
# docker-compose overrides this for containers; this value is for running a service outside Docker.
POSTGRESQL_URI=postgresql://postgres:password@localhost:5434/

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Redis (cache + rate limits in problem-service) ---
REDIS_URL=redis://redis:6379/0
SUBMISSION_RATE_LIMIT_PER_MINUTE=10
# Contests that need AI-generated problems, per user per hour
AI_GENERATION_RATE_LIMIT=10

# Shared by all services (auth-service signs, the others only verify). Use a long random string.
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Judge0 (already running in WSL, NOT part of docker-compose) ---
# Containers reach it via host.docker.internal (extra_hosts: host-gateway in docker-compose.yml)
JUDGE0_URL=http://host.docker.internal:2358
# Only if your Judge0 has AUTHN_TOKEN set; sent as X-Auth-Token
JUDGE0_AUTH_TOKEN=
JUDGE0_TIMEOUT_SECONDS=30

MAX_CODE_SIZE=65536
# Per test case limits sent to Judge0
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_MB=256

# Regenerate up to this many times when the reference solution fails Judge0 validation
AI_MAX_GENERATION_ATTEMPTS=3

# --- Daily challenge job (APScheduler inside ai-service) ---
DAILY_JOB_ENABLED=true
DAILY_JOB_HOUR_UTC=0
DAILY_TOPICS=arrays,strings,hashing,two pointers,stack,binary search,sorting,greedy,dynamic programming,math

CORS_ORIGINS=*

# Shared secret for service-to-service calls (/internal/* endpoints).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=changeme-service-token
